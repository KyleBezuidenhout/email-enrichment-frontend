# Supabase Configuration
# Get these from: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here

# Mail Tester API Keys
# Get these from your Mail Tester account
MAIL_TESTER_API_KEY=your_primary_mail_tester_key
MAIL_TESTER_API_KEY_1=your_secondary_mail_tester_key
MAIL_TESTER_API_KEY_2=your_tertiary_mail_tester_key

# Optional: Vayne.io API (for Sales Navigator integration - Phase 2)
# VAYNE_API_KEY=your_vayne_api_key
# VAYNE_API_URL=https://api.vayne.io

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=your_google_analytics_id

# Optional: Error Tracking
# SENTRY_DSN=your_sentry_dsn
